<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_delivery_address" model="ir.ui.view">
        <field name="name">account.move.form.inherit.delivery.address</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="after">
                <page id="delivery_address_tab" string="Delivery Address" name="delivery_address" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <div class="mb-2" invisible="state != 'draft'">
                        <button name="action_copy_customer_address"
                                type="object"
                                string="Copy Customer Address"
                                icon="fa-clone"
                                class="btn-secondary btn-sm me-2"/>
                        <button name="action_clear_delivery_address"
                                type="object"
                                string="Clear"
                                icon="fa-trash-o"
                                class="btn-link btn-sm text-danger"/>
                    </div>
                    <group>
                        <group string="Recipient Information">
                            <field name="delivery_name" placeholder="Contact or Business Name" readonly="state != 'draft'"/>
                            <field name="delivery_phone" placeholder="Contact Phone / Mobile" readonly="state != 'draft'"/>
                        </group>
                        <group string="Address Details">
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="delivery_street" placeholder="Street..." class="o_address_street" readonly="state != 'draft'"/>
                                <field name="delivery_street2" placeholder="Street 2..." class="o_address_street" readonly="state != 'draft'"/>
                                <field name="delivery_city" placeholder="City" class="o_address_city" readonly="state != 'draft'"/>
                                <field name="delivery_state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" readonly="state != 'draft'"/>
                                <field name="delivery_zip" placeholder="ZIP / PIN Code" class="o_address_zip" readonly="state != 'draft'"/>
                                <field name="delivery_country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_quick_create': True}" readonly="state != 'draft'"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
