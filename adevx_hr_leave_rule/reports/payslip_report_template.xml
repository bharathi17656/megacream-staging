<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payslip Report Customization for Cash Print and Bank Print Options -->
        <template id="report_payslip_inherit_cash_bank" inherit_id="hr_payroll.report_payslip" priority="99">
            
            <!-- 1. Worked Days Table: Filter out Double Pay when ONLY Bank Print is selected -->
            <xpath expr="//tbody[@id='worked_days_lines']" position="replace">
                <tbody id="worked_days_lines">
                    <t t-set="worked_days_lines" t-value="o.get_filtered_worked_days_line_ids()"/>
                    <span t-foreach="worked_days_lines" t-as="worked_days">
                        <tr style="color:none">
                            <td id="worked_days_name"><span t-field="worked_days.name"/></td>
                            <td id="worked_days_hours" class="text-end"><span t-out="round(worked_days.number_of_hours, 2)"/></td>
                            <td id="worked_days_days" class="text-end"><span t-out="round(worked_days.number_of_days, 2)"/></td>
                            <td id="worked_days_amount" class="text-end">
                                <t t-if="o.cash_print and o.bank_print">
                                    <span t-out="worked_days.amount" digits="[42, 2]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </t>
                                <t t-else="">
                                    <span t-out="o.get_worked_days_line_amount(worked_days)" digits="[42, 2]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </t>
                            </td>
                        </tr>
                    </span>
                    <span>
                        <t t-set="line_class" t-value="'o_total o_border_bottom fw-bold'"/>
                        <tr style="color:none">
                            <td t-att-class="line_class">
                                <span>Total</span>
                            </td>
                            <td id="worked_days_total_hours" t-attf-class="#{line_class} text-end">
                                <span t-out="round(sum(worked_days_lines.mapped('number_of_hours')), 2)"/>
                            </td>
                            <td id="worked_days_total_days" t-attf-class="#{line_class} text-end">
                                <span t-out="round(sum(worked_days_lines.mapped('number_of_days')), 2)"/>
                            </td>
                            <td id="worked_days_total_amount" t-attf-class="#{line_class} text-end">
                                <t t-if="o.cash_print and o.bank_print">
                                    <span t-out="sum(worked_days_lines.mapped('amount'))" digits="[42, 2]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </t>
                                <t t-else="">
                                    <span t-out="o.get_worked_days_total_amount()" digits="[42, 2]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </t>
                            </td>
                        </tr>
                    </span>
                </tbody>
            </xpath>

            <!-- 2. Summary Lines Table Loop: Filter rows dynamically based on selected boolean -->
            <xpath expr="//tbody[@id='payslip_lines']/span" position="attributes">
                <attribute name="t-foreach">o.get_filtered_print_line_ids()</attribute>
            </xpath>

            <!-- 3. Summary Line Total Amount: If Both -> Standard line total, Else -> Computed total -->
            <xpath expr="//td[@id='payslip_line_total']/span" position="replace">
                <t t-if="o.cash_print and o.bank_print">
                    <span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </t>
                <t t-else="">
                    <span t-out="o.get_payslip_line_total(line)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </t>
            </xpath>

            <!-- 4. To Pay Section: Render specific text & amount based on selected boolean -->
            <xpath expr="//div[@id='to_pay']" position="replace">
                <div id="to_pay">
                    <!-- Both Cash & Bank Selected -->
                    <t t-if="o.cash_print and o.bank_print">
                        <p t-if="(o.net_payable or 0.0) &gt;= 0">
                            To pay on 
                            <span class="fw-bold" t-esc="o._get_employee_bank_account_number()"/>
                            of <span class="fst-italic" t-field="o.employee_id.legal_name"/>: 
                            <span t-esc="o.net_payable" class="fw-bold" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </p>
                    </t>

                    <!-- Only Cash Print Selected -->
                    <t t-elif="o.cash_print">
                        <p t-if="(o.cash_payable or 0.0) &gt;= 0">
                            To pay in Cash to <span class="fst-italic" t-field="o.employee_id.legal_name"/>: 
                            <span t-esc="o.cash_payable" class="fw-bold" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </p>
                    </t>

                    <!-- Only Bank Print Selected -->
                    <t t-elif="o.bank_print">
                        <p t-if="(o.print_net_salary or 0.0) &gt;= 0">
                            To pay on 
                            <span class="fw-bold" t-esc="o._get_employee_bank_account_number()"/>
                            of <span class="fst-italic" t-field="o.employee_id.legal_name"/>: 
                            <span t-esc="o.print_net_salary" class="fw-bold" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </p>
                    </t>

                    <p t-if="(o.print_net_salary or 0.0) &lt; 0">
                        The net amount will be recovered from the first positive remuneration established after this.
                    </p>
                </div>
            </xpath>

        </template>
    </data>
</odoo>
