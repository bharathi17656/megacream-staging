<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslipdetails_inherit_cash_bank" inherit_id="hr_payroll.report_payslipdetails">
        <!-- Worked Days / Earnings table amount customization -->
        <xpath expr="//table[hasclass('table') and contains(., 'Attendance')]//tbody//tr" position="replace" optional="1">
            <t t-foreach="o.worked_days_line_ids" t-as="line">
                <tr>
                    <td><span t-field="line.name"/></td>
                    <td><span t-field="line.number_of_hours"/></td>
                    <td><span t-field="line.number_of_days"/></td>
                    <td class="text-end">
                        <span t-esc="o.get_worked_days_line_amount(line)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>

        <!-- Footer line text customization -->
        <xpath expr="//p[contains(., 'To pay')]" position="replace" optional="1">
            <p class="text-center" style="margin-top: 15px;">
                <strong><span t-esc="o.get_print_footer_text()"/></strong>
            </p>
        </xpath>
    </template>
</odoo>
