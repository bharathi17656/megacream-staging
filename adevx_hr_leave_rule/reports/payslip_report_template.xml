<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- India Payslip Report Customization -->
        <template id="report_payslip_in_inherit_cash_bank" inherit_id="l10n_in_hr_payroll.report_payslip_in">
            <!-- Worked Days Table Amount Column -->
            <xpath expr="//tbody[@id='worked_days_lines']" position="replace">
                <tbody id="worked_days_lines">
                    <t t-set="worked_days_lines" t-value="o.worked_days_line_ids.filtered(lambda worked_days: worked_days.code != 'OUT')"/>
                    <t t-foreach="worked_days_lines" t-as="worked_days">
                        <tr style="color:none">
                            <td id="worked_days_name"><span t-field="worked_days.name"/></td>
                            <td class="text-end">
                                <span t-if="o.wage_type == 'hourly'" t-field="worked_days.number_of_hours"> Hours</span>
                                <span t-else="" t-field="worked_days.number_of_days"> Days</span>
                            </td>
                            <td class="text-end">
                                <span t-esc="o.get_worked_days_line_amount(worked_days)" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </xpath>

            <!-- Footer / Net Payable Text & Amount -->
            <xpath expr="//div[h6[contains(text(), 'Total Net Payable')]]" position="replace">
                <div t-if="o.net_wage &gt;= 0">
                    <h6 class="mb-0">Total Net Payable 
                        <strong t-esc="o.print_net_salary" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </h6>
                    <p>(<span t-out="o.currency_id.with_context(lang='en_US').amount_to_text(o.print_net_salary)"/> Only)</p>
                </div>
            </xpath>
        </template>

        <!-- Standard / Protectol Payslip Report Customization -->
        <template id="report_payslip_inherit_cash_bank" inherit_id="hr_payroll.report_payslip">
            <!-- Filter salary summary lines based on Cash / Bank booleans -->
            <xpath expr="//span[contains(@t-foreach, 'line_ids')]" position="replace">
                <span t-foreach="o.get_filtered_print_line_ids()" t-as="line">
                    <t t-set="line_style"/>
                    <t t-set="line_class"/>
                    <t t-if="line.code == 'NET'">
                        <t t-set="line_style" t-value="'color:#875A7B;'"/>
                        <t t-set="line_class" t-value="'o_total o_border_bottom fw-bold'"/>
                    </t>
                    <t t-if="(line.code == 'BASIC') or (line.code == 'GROSS')">
                        <t t-set="line_style" t-value="'color:#00A09D;'"/>
                        <t t-set="line_class" t-value="'o_subtotal o_border_bottom'"/>
                    </t>
                    <tr t-att-class="line_class" t-att-style="line_style" id="line_display">
                        <td>
                            <span t-field="line.name"/>
                        </td>
                        <td>
                            <span t-if="line.quantity &gt; 1" t-esc="line.quantity"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="o.get_payslip_line_total(line)"
                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                  t-att-style="'color:#875A7B;' if o.get_payslip_line_total(line) &lt; 0 else ''"/>
                        </td>
                    </tr>
                </span>
            </xpath>

            <!-- Footer Text Customization -->
            <xpath expr="//p[contains(., 'To pay')]" position="replace">
                <p t-if="o.print_net_salary &gt;= 0">
                    <t t-if="o.bank_print and o.employee_id.bank_account_id">
                        To pay on
                        <b><span t-field="o.employee_id.bank_account_id"/></b>
                        of
                        <i><span t-field="o.employee_id"/></i>
                        :
                        <span t-esc="o.print_net_salary" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </t>
                    <t t-elif="o.cash_print">
                        To pay in Cash to
                        <i><span t-field="o.employee_id"/></i>
                        :
                        <span t-esc="o.print_net_salary" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </t>
                    <t t-else="">
                        To pay to
                        <i><span t-field="o.employee_id"/></i>
                        :
                        <span t-esc="o.print_net_salary" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </t>
                </p>
            </xpath>
        </template>
    </data>
</odoo>
