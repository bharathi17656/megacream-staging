<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l4e_sale_order_batch_wizard_form" model="ir.ui.view">
        <field name="name">l4e.sale.order.batch.wizard.form</field>
        <field name="model">l4e.sale.order.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Batches for Sales Order">
                <sheet>
                    <div class="alert alert-info d-flex align-items-center justify-content-between mb-3" role="alert">
                        <div>
                            <strong>Product: </strong><field name="product_id" readonly="1" class="fw-bold"/>
                            <span class="mx-2">|</span>
                            <strong>Required Qty: </strong><field name="required_qty" readonly="1" class="fw-bold"/> <field name="uom_id" readonly="1"/>
                        </div>
                        <div>
                            <button name="action_auto_allocate_fifo"
                                    type="object"
                                    string="⚡ Auto-Fill (FIFO)"
                                    class="btn btn-outline-primary btn-sm"
                                    help="Automatically allocate quantities from oldest available batches first"/>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="card bg-light border-0 p-2 text-center">
                                <span class="text-muted small">Total Allocated</span>
                                <h4 class="mb-0 text-primary"><field name="allocated_qty" readonly="1"/></h4>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0 p-2 text-center">
                                <span class="text-muted small">Remaining to Allocate</span>
                                <h4 class="mb-0"><field name="remaining_qty" readonly="1"/></h4>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted small mb-2">
                        Specify how many units to take from each batch below. Click <strong>Apply Allocation</strong> to split this line into the selected batches.
                    </p>

                    <field name="allocation_line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="batch_id" string="Batch Number" readonly="1" force_save="1" options="{'no_open': True}"/>
                            <field name="date" string="Batch Date" widget="date" readonly="1"/>
                            <field name="available_qty" string="Available Stock" decoration-success="available_qty &gt; 0" readonly="1" force_save="1"/>
                            <field name="allocated_qty" string="Quantity to Take" class="fw-bold"/>
                        </list>
                    </field>
                </sheet>

                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Apply Allocation"
                            class="btn-primary"
                            invisible="remaining_qty &gt; 0"/>
                    <button name="action_apply_and_adjust_qty"
                            type="object"
                            string="Apply &amp; Set Order Qty to Allocated"
                            class="btn-primary"
                            invisible="remaining_qty &lt;= 0 or allocated_qty &lt;= 0"
                            confirm="The allocated quantity is less than required. Do you want to adjust the order line quantity to match the allocated batches?"/>
                    <button name="action_apply"
                            type="object"
                            string="Apply Allocation"
                            class="btn-outline-primary"
                            invisible="remaining_qty &lt;= 0"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>