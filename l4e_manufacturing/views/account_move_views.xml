<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l4e_batch" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l4e.batch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="batch_id"
                       string="Batch Number"
                       domain="['|', ('product_id', '=', product_id), ('output_line_ids.product_id', '=', product_id)]"
                       context="{'hide_depleted_batches': True, 'filter_product_id': product_id}"
                       options="{'no_create': True}"
                       optional="show"/>
                <field name="batch_available_qty"
                       string="Batch Avail."
                       optional="hide"/>
                <field name="batch_status"
                       widget="badge"
                       decoration-success="batch_status == 'in_stock'"
                       decoration-danger="batch_status == 'finished'"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
