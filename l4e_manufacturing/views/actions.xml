<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING BATCHES — Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_ice_cream_processing_batch" model="ir.actions.act_window">
        <field name="name">Processing Batches</field>
        <field name="res_model">l4e.icecream.processing.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ice_cream_processing_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Ice Cream Processing Batch
            </p>
            <p>
                Track raw materials (milk, cream, sugar, flavors) through processing into finished ice cream goods.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING COST REPORT — Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_ice_cream_processing_cost_report" model="ir.actions.act_window">
        <field name="name">Processing Cost Report</field>
        <field name="res_model">l4e.icecream.processing.batch</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ice_cream_processing_cost_report_list"/>
        <field name="search_view_id" ref="view_ice_cream_processing_batch_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Processing Cost Report
            </p>
            <p>
                Compares ingredient cost issued into production vs. finished ice cream goods value recorded.
            </p>
        </field>
    </record>

    <record id="action_ice_cream_cost_report_list_binding" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ice_cream_processing_cost_report_list"/>
        <field name="act_window_id" ref="action_ice_cream_processing_cost_report"/>
    </record>

    <record id="action_ice_cream_cost_report_form_binding" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ice_cream_processing_batch_form"/>
        <field name="act_window_id" ref="action_ice_cream_processing_cost_report"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         WASTAGE MASTER — Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_ice_cream_wastage_master" model="ir.actions.act_window">
        <field name="name">Wastage Master</field>
        <field name="res_model">l4e.icecream.wastage.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_l4e_icecream_wastage_line_search"/>
        <field name="context">{'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Wastage Recorded Yet
            </p>
            <p>
                Track and analyze ice cream manufacturing wastages by date, finished product, and reason.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         WASTAGE REASONS — Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_ice_cream_wastage_reason" model="ir.actions.act_window">
        <field name="name">Wastage Reasons</field>
        <field name="res_model">l4e.icecream.wastage.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Wastage Reasons
            </p>
            <p>
                Configure causes of manufacturing wastages (e.g., Spillage, QC Defect, Packaging Damage).
            </p>
        </field>
    </record>

</odoo>
