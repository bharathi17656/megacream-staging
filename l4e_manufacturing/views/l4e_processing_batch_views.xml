<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING BATCHES — List View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_ice_cream_processing_batch_list" model="ir.ui.view">
        <field name="name">l4e.icecream.processing.batch.list</field>
        <field name="model">l4e.icecream.processing.batch</field>
        <field name="arch" type="xml">
            <list string="Processing Batches"
                  decoration-info="state in ('draft', 'at_store')"
                  decoration-warning="state == 'processing'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Order Reference"/>
                <field name="batch_number" string="Batch Number"/>
                <field name="date" string="Requested Date"/>
                <field name="product_id" string="Finished Product"/>
                <field name="total_raw_qty" string="Total Raw Qty" sum="Total Raw Material"/>
                <field name="total_output_qty" string="Gross Output" sum="Total Gross Output"/>
                <field name="total_wastage_qty" string="Total Wastage" sum="Total Wastage" optional="show"/>
                <field name="total_net_output_qty" string="Net Output" sum="Total Net Output" optional="show"/>
                <field name="yield_percentage" string="Yield %"/>
                <field name="state" widget="badge" string="Status"
                       decoration-info="state in ('draft', 'at_store')"
                       decoration-warning="state == 'processing'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING COST REPORT — List View
     ═══════════════════════════════════════════════════════ -->
    <record id="view_ice_cream_processing_cost_report_list" model="ir.ui.view">
        <field name="name">l4e.icecream.processing.cost.report.list</field>
        <field name="model">l4e.icecream.processing.batch</field>
        <field name="arch" type="xml">
            <list string="Processing Cost Report" create="false" edit="false" delete="false"
                  decoration-info="state in ('draft', 'at_store')"
                  decoration-warning="state == 'processing'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Order Reference"/>
                <field name="batch_number" string="Batch Number"/>
                <field name="date" string="Requested Date"/>
                <field name="product_id" string="Finished Product"/>
                <field name="total_raw_qty" string="Total Raw Qty" sum="Total Raw Qty"/>
                <field name="raw_cost_issued" string="Raw Cost Issued" sum="Total Raw Cost Issued" widget="monetary"/>
                <field name="total_output_qty" string="Total Output" sum="Total Output Qty"/>
                <field name="finished_goods_value" string="Finished Goods Value" sum="Total FG Value Recorded" widget="monetary"/>
                <field name="value_difference" string="Value Variance / Gain" sum="Total Variance / Gain" widget="monetary"
                       decoration-success="value_difference &gt; 0"
                       decoration-danger="value_difference &lt; 0"/>
                <field name="yield_percentage" string="Yield %"/>
                <field name="state" widget="badge" string="Status"
                       decoration-info="state in ('draft', 'at_store')"
                       decoration-warning="state == 'processing'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         BATCH SELECTION LIST VIEW (FOR SALES & INVOICES)
     ═══════════════════════════════════════════════════════ -->
    <record id="view_ice_cream_batch_sale_selection_list" model="ir.ui.view">
        <field name="name">l4e.icecream.processing.batch.sale.selection.list</field>
        <field name="model">l4e.icecream.processing.batch</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Select Batch" create="false" edit="false" delete="false">
                <field name="batch_number" string="Batch Number"/>
                <field name="product_id" string="Product Name"/>
                <field name="batch_available_qty" string="Available Quantity"/>
                <field name="date" string="Date" widget="date"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING BATCH — Form View
     ═══════════════════════════════════════════════════════ -->
    <record id="view_ice_cream_processing_batch_form" model="ir.ui.view">
        <field name="name">l4e.icecream.processing.batch.form</field>
        <field name="model">l4e.icecream.processing.batch</field>
        <field name="arch" type="xml">
            <form string="Processing Batch">
                <header>
                    <field name="is_sales_user" invisible="1"/>
                    <field name="is_store_confirmed" invisible="1"/>
                    <button name="action_submit_request"
                            string="Submit Request"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start_processing"
                            string="Start Processing"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft' or is_sales_user"/>
                    <button name="action_store_confirm"
                            string="Confirm"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'at_store' or is_store_confirmed or is_sales_user"/>
                    <button name="action_transfer"
                            string="Transfer"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'at_store' or not is_store_confirmed or is_sales_user"/>
                    <button name="action_complete_processing"
                            string="Complete Processing"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'processing'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state in ('draft', 'at_store') or is_sales_user"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('completed', 'cancel')"
                            confirm="Are you sure you want to cancel this processing batch?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,at_store,processing,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_manufacturing_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="Manufacturing"/>
                        </button>
                        <button name="action_view_raw_transfer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not raw_transfer_id">
                            <field name="raw_transfer_state" widget="statinfo" string="Raw Transfer"/>
                        </button>
                        <button name="action_view_finished_transfer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not finished_transfer_id">
                            <field name="finished_transfer_state" widget="statinfo" string="Finished Transfer"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <field name="is_sales_user" invisible="1"/>
                    <field name="is_store_confirmed" invisible="1"/>
                    <group>
                        <group string="Batch Information">
                            <field name="date" string="Requested Date" readonly="state != 'draft'"/>
                            <field name="batch_number" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Locations">
                            <field name="source_location_id" readonly="state != 'draft' or is_sales_user"/>
                            <field name="wip_location_id" readonly="state != 'draft' or is_sales_user"/>
                            <field name="finished_location_id" readonly="state != 'draft' or is_sales_user"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Raw Materials" name="raw_ingredients">
                            <field name="raw_line_ids" readonly="state not in ('draft', 'at_store') or is_sales_user or is_store_confirmed">
                                <list editable="bottom">
                                    <field name="product_id" string="Ingredient"/>
                                    <field name="raw_lot_ids" widget="many2many_tags" options="{'no_create': True}" optional="show"/>
                                    <field name="quantity" string="Quantity Consumed"/>
                                    <field name="uom_id" readonly="1" string="UoM"/>
                                    <field name="unit_cost" readonly="1" string="Unit Cost" widget="monetary" optional="show"/>
                                    <field name="total_cost" readonly="1" string="Total Cost" widget="monetary" sum="Total Raw Cost"/>
                                </list>
                            </field>
                        </page>

                        <page string="Finished Product" name="finished_output">
                            <field name="output_line_ids" readonly="state not in ('draft', 'at_store', 'processing') or (state != 'draft' and is_sales_user)">
                                <list editable="bottom">
                                    <field name="product_id" string="Finished Product"/>
                                    <field name="packaging_no" string="Tub / Packaging No" optional="show" column_invisible="parent.is_sales_user"/>
                                    <field name="quantity" string="Gross Produced" column_invisible="parent.is_sales_user"/>
                                    <field name="wastage_quantity" string="Wastage Qty" readonly="1" sum="Total Wastage" column_invisible="parent.is_sales_user"/>
                                    <field name="net_quantity" string="Net FG Qty" sum="Total Net FG"/>
                                    <field name="uom_id" readonly="1" string="UoM"/>
                                    <field name="unit_price" string="Unit Price" widget="monetary" optional="show" column_invisible="parent.is_sales_user"/>
                                    <field name="total_value" readonly="1" string="Total Value" widget="monetary" sum="Total FG Value" column_invisible="parent.is_sales_user"/>
                                    <field name="remarks" string="Remarks" optional="hide" column_invisible="parent.is_sales_user"/>
                                </list>
                            </field>
                        </page>

                        <page string="Wastage" name="wastage" invisible="state in ('draft', 'at_store', 'cancel')">
                            <field name="wastage_line_ids" readonly="state != 'processing'">
                                <list editable="bottom">
                                    <field name="allowed_product_ids" column_invisible="1"/>
                                    <field name="name" string="Wastage Ref" readonly="1" optional="show"/>
                                    <field name="product_id" string="Finished Product" domain="[('id', 'in', allowed_product_ids)]"/>
                                    <field name="packaging_no" string="Tub / Packaging No" optional="show"/>
                                    <field name="quantity" string="Wastage Quantity"/>
                                    <field name="uom_id" readonly="1" string="UoM"/>
                                    <field name="reason_id" string="Reason" options="{'no_open': False, 'no_create_edit': False}"/>
                                    <field name="unit_cost" readonly="1" string="Unit Cost" widget="monetary" optional="show"/>
                                    <field name="total_loss_value" readonly="1" string="Loss Value" widget="monetary" sum="Total Loss Value"/>
                                    <field name="remarks" string="Remarks" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Transfers &amp; Audit" name="transfers_audit">
                            <group>
                                <group string="Stock Pickings">
                                    <field name="raw_transfer_id" readonly="1"/>
                                    <field name="finished_transfer_id" readonly="1"/>
                                </group>
                                <group string="Audit Timestamps">
                                    <field name="processing_started_by" readonly="1" invisible="not processing_started_by"/>
                                    <field name="processing_started_on" readonly="1" invisible="not processing_started_on"/>
                                    <field name="processing_completed_by" readonly="1" invisible="not processing_completed_by"/>
                                    <field name="processing_completed_on" readonly="1" invisible="not processing_completed_on"/>
                                </group>
                            </group>
                            <group string="Remarks">
                                <field name="remarks" nolabel="1" placeholder="Enter processing remarks / quality notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PROCESSING BATCH — Search View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_ice_cream_processing_batch_search" model="ir.ui.view">
        <field name="name">l4e.icecream.processing.batch.search</field>
        <field name="model">l4e.icecream.processing.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Order Reference"/>
                <field name="batch_number" string="Batch Number"/>
                <field name="product_id"/>
                <field name="source_location_id"/>
                <field name="finished_location_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="At Store" name="filter_at_store" domain="[('state', '=', 'at_store')]"/>
                <filter string="Processing" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Finished Product" name="groupby_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested Date" name="groupby_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
