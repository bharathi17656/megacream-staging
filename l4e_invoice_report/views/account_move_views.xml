<odoo>
    <record id="view_move_form_l4e_readonly_payment_term" model="ir.ui.view">
        <field name="name">account.move.form.l4e.readonly.payment.term</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="before">
                <field name="l4e_is_payment_term_readonly" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="readonly">l4e_is_payment_term_readonly</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_l4e_extra_contact_fields" model="ir.ui.view">
        <field name="name">account.move.form.l4e.extra.contact.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Left side: stays with Accounts Contact Number -->
            <xpath expr="//field[@name='accounts_contact_number']" position="after">
                <field name="accounts_name"/>
                <field name="salesperson_name"/>
            </xpath>

            <!-- Right side: next to Invoice Date / Due Date / Currency -->
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="store_person_name"/>
                <field name="store_person_number"/>
            </xpath>
        </field>
    </record>
</odoo>