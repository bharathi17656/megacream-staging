<odoo>
    <record id="view_partner_form_l4e_invoice_payment_term" model="ir.ui.view">
        <field name="name">res.partner.form.l4e.invoice.payment.term</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Invoicing" name="l4e_invoicing">
                    <field name="l4e_invoice_payment_term_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>