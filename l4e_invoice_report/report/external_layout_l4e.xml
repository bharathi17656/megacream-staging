<odoo>
    <template id="external_layout_folder_l4e_inherit" inherit_id="web.external_layout_folder">
        <xpath expr="//div[@name='company_address']" position="replace">
            <div class="col-5 text-end d-none" name="company_address" style="display: none !important;"/>
        </xpath>
    </template>

    <template id="external_layout_wave_l4e_inherit" inherit_id="web.external_layout_wave">
        <xpath expr="//div[@name='company_address']" position="replace">
            <div class="col-5 text-end d-none" name="company_address" style="display: none !important;"/>
        </xpath>
    </template>
</odoo>