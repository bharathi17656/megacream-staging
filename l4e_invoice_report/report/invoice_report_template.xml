<odoo>
    <template id="report_invoice_document_l4e_inherit" inherit_id="account.report_invoice_document">

        <!-- (2) Customer/Vendor block: remove raw phone/email from contact widget, and append structured details below Place of Supply -->
        <xpath expr="//div[@name='no_shipping']//address[@t-field='o.partner_id']" position="replace">
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']//address[@t-field='o.partner_id']" position="replace">
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
        <xpath expr="//div[@name='address_not_same_as_shipping']//address[@t-field='o.partner_id']" position="replace">
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>

        <!-- Append structured contact, GST and FSSAI details below Place of supply / address block without top gap -->
        <xpath expr="//div[@name='no_shipping']" position="inside">
            <div class="mt-0 pt-0" style="font-size: 13px; line-height: 1.4; margin-top: 0 !important;">
                <div t-if="o.partner_id.phone">
                    <strong>Contact No : </strong>
                    <span t-field="o.partner_id.phone"/>
                </div>
                <div t-if="o.partner_id.email">
                    <strong>Email : </strong>
                    <span t-field="o.partner_id.email"/>
                </div>
                <div t-if="'l10n_in_gst_treatment' in o.partner_id._fields and o.partner_id.l10n_in_gst_treatment">
                    <strong>GST Treatment : </strong>
                    <span t-field="o.partner_id.l10n_in_gst_treatment"/>
                </div>
                <div t-if="o.partner_id.vat">
                    <strong>GSTIN : </strong>
                    <span t-field="o.partner_id.vat"/>
                </div>
                <div t-if="'fssai_no' in o.partner_id._fields and o.partner_id.fssai_no">
                    <strong>FSSAI No : </strong>
                    <span t-field="o.partner_id.fssai_no"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']" position="inside">
            <div class="mt-0 pt-0" style="font-size: 13px; line-height: 1.4; margin-top: 0 !important;">
                <div t-if="o.partner_id.phone">
                    <strong>Contact No : </strong>
                    <span t-field="o.partner_id.phone"/>
                </div>
                <div t-if="o.partner_id.email">
                    <strong>Email : </strong>
                    <span t-field="o.partner_id.email"/>
                </div>
                <div t-if="'l10n_in_gst_treatment' in o.partner_id._fields and o.partner_id.l10n_in_gst_treatment">
                    <strong>GST Treatment : </strong>
                    <span t-field="o.partner_id.l10n_in_gst_treatment"/>
                </div>
                <div t-if="o.partner_id.vat">
                    <strong>GSTIN : </strong>
                    <span t-field="o.partner_id.vat"/>
                </div>
                <div t-if="'fssai_no' in o.partner_id._fields and o.partner_id.fssai_no">
                    <strong>FSSAI No : </strong>
                    <span t-field="o.partner_id.fssai_no"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_not_same_as_shipping']" position="inside">
            <div class="mt-0 pt-0" style="font-size: 13px; line-height: 1.4; margin-top: 0 !important;">
                <div t-if="o.partner_id.phone">
                    <strong>Contact No : </strong>
                    <span t-field="o.partner_id.phone"/>
                </div>
                <div t-if="o.partner_id.email">
                    <strong>Email : </strong>
                    <span t-field="o.partner_id.email"/>
                </div>
                <div t-if="'l10n_in_gst_treatment' in o.partner_id._fields and o.partner_id.l10n_in_gst_treatment">
                    <strong>GST Treatment : </strong>
                    <span t-field="o.partner_id.l10n_in_gst_treatment"/>
                </div>
                <div t-if="o.partner_id.vat">
                    <strong>GSTIN : </strong>
                    <span t-field="o.partner_id.vat"/>
                </div>
                <div t-if="'fssai_no' in o.partner_id._fields and o.partner_id.fssai_no">
                    <strong>FSSAI No : </strong>
                    <span t-field="o.partner_id.fssai_no"/>
                </div>
            </div>
        </xpath>

        <!-- (4) Salesperson name + contact, next to Reference/Source. -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.l4e_salesperson_name" class="col" name="l4e_salesperson">
                <strong>Sales Person:</strong>
                <p t-field="o.l4e_salesperson_name"/>
            </div>
            <div t-if="o.l4e_salesperson_contact" class="col" name="l4e_salesperson_contact">
                <strong>Contact NO:</strong>
                <p t-field="o.l4e_salesperson_contact"/>
            </div>
        </xpath>

        <!-- (5) Item Code column -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//th[@name='th_description']" position="before">
            <th name="th_item_code" class="text-start">
                <span>Item Code</span>
            </th>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]//tbody//td[@name='account_invoice_line_name']" position="before">
            <td name="td_item_code">
                <span t-field="line.product_id.l4e_item_code"/>
            </td>
        </xpath>

        <!-- (6) HSN/SAC column -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//th[@name='th_description']" position="after">
            <th name="th_hsn_sac" class="text-start" t-if="o.company_id.account_fiscal_country_id.code == 'IN' and o.company_id.l10n_in_is_gst_registered">
                <span>HSN/SAC</span>
            </th>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]//tbody//td[@name='account_invoice_line_name']" position="after">
            <td name="td_hsn_sac" t-if="o.company_id.account_fiscal_country_id.code == 'IN' and o.company_id.l10n_in_is_gst_registered">
                <span t-out="line.l10n_in_hsn_code or line.product_id.l10n_in_hsn_code"/>
            </td>
        </xpath>

        <!-- (7) Rename "Unit Price" header to "Rate" -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//th[@name='th_priceunit']/span" position="replace">
            <span>Rate</span>
        </xpath>

        <!-- (8) Total row -->
        <xpath expr="//tbody[hasclass('invoice_tbody')]" position="inside">
            <tr class="fw-bold" name="l4e_total_qty_row" style="border-top: 1px solid #000;">
                <td t-att-colspan="2 + (1 if o.company_id.account_fiscal_country_id.code == 'IN' and o.company_id.l10n_in_is_gst_registered else 0)" class="text-end">
                    <span>Total</span>
                </td>
                <td name="td_total_qty" class="o_td_quantity text-end">
                    <span t-out="sum(o.invoice_line_ids.mapped('quantity'))"/>
                </td>
                <td t-att-colspan="4 if o.tax_totals.get('subtotals') else 3"/>
            </tr>
        </xpath>

        <!-- (9) Bank details block at the bottom of the invoice page -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-3" name="l4e_bank_details">
                <div class="col-6">
                    <strong>Bank Account Details:</strong><br/>
                    <strong>Bank Name:</strong> Federal Bank<br/>
                    <strong>Branch:</strong> Kilpauk<br/>
                    <strong>A/C No:</strong> 15230200003058<br/>
                    <strong>IFSC Code:</strong> FDRL0001523
                </div>
            </div>
        </xpath>

    </template>
</odoo>