<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_certificate_list" model="ir.ui.view">
        <field name="name">res.partner.certificate.list</field>
        <field name="model">res.partner.certificate</field>
        <field name="arch" type="xml">
            <list delete="1">
                <field name="name" string="Certificate Name"/>
                <field name="file_name" column_invisible="1"/>
                <field name="certificate_file" filename="file_name" widget="binary" string="File"/>
                <field name="expiry_date" string="Expiration Date"/>
            </list>
        </field>
    </record>

    <record id="view_res_partner_certificate_form" model="ir.ui.view">
        <field name="name">res.partner.certificate.form</field>
        <field name="model">res.partner.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate">
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="name" string="Certificate Name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="certificate_file" filename="file_name" widget="binary" string="Certificate File"/>
                        <field name="expiry_date" string="Expiration Date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_inherit_l4e_custom_fields" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l4e.custom.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="required">not parent_id</attribute>
            </xpath>

            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="is_vendor"/>
                <field name="is_customer"/>
                <field name="accounts_contact_number" required="not parent_id"/>
                <field name="accounts_name" required="not parent_id"/>
                <field name="salesperson_name" required="not parent_id"/>
                <field name="sales_contact_number" required="not parent_id"/>
            </xpath>

            <xpath expr="//field[@name='website']" position="before">
                <field name="fssai_no" placeholder="e.g. 12345678901234"/>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="store_person_name" required="not parent_id"/>
                <field name="store_person_number" required="not parent_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Certificates" name="certificates">
                    <div class="mb-2">
                        <button name="action_open_certificate_wizard"
                                type="object"
                                string="Upload Certificate"
                                icon="fa-paperclip"
                                class="btn-secondary"
                                context="{'skip_vendor_cert_check': True}"/>
                    </div>
                    <field name="certificate_ids" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
