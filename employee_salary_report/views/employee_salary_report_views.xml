<odoo>
    <!-- List view -->
    <record id="view_employee_salary_report_tree" model="ir.ui.view"> 
        <field name="name">employee.salary.report.list</field>
        <field name="model">employee.salary.report</field>
        <field name="arch" type="xml">
            <list string="Salary Reports">
                <field name="month_name"/>
                <field name="employee_id"/>
                <field name="total_working_days_in_month"/>
                <field name="gross_salary"/>
                <field name="basic_da"/>
                <field name="hra"/>
                <field name="spl_allowance"/>
                <field name="employee_pf"/>
                <field name="professional_tax"/>
                <field name="net_salary"/>
            </list> 
        </field>
    </record>

    <!-- Form view -->
    <record id="view_employee_salary_report_form" model="ir.ui.view">
        <field name="name">employee.salary.report.form</field>
        <field name="model">employee.salary.report</field>
        <field name="arch" type="xml">
            <form string="Employee Salary Report">
                <sheet>
                    <!-- Header -->
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="contract_id"/>
                            <field name="payslip_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="month_name" readonly="1"/>
                        </group>
                    </group>

                    <!-- Attendance Summary -->
                    <group string="Attendance Summary">
                        <field name="total_days_in_month"/>
                        <field name="total_working_days_in_month"/>
                    </group>

                    <!-- Earnings -->
                    <group>
                        <group string="Earnings">
                            <field name="gross_salary"/>
                            <field name="basic_da"/>
                            <field name="hra"/>
                            <field name="spl_allowance"/>
                            <field name="conveyance"/>
                            <field name="bonus"/>
                            <field name="leave_encashment"/>
                        </group>

                        <!-- Deductions -->
                        <group string="Deductions">
                            <field name="employee_pf"/>
                            <field name="professional_tax"/>
                            <field name="other_deduction"/>
                        </group>
                    </group>

                    <!-- Employer & Summary -->
                    <group>
                        <group string="Employer Contribution">
                            <field name="employer_pf"/>
                            <field name="employer_esi"/>
                            <field name="gratuity"/>
                        </group>

                        <group string="Summary">
                            <field name="net_salary"/>
                            <field name="monthly_ctc"/>
                            <field name="yearly_ctc"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_employee_salary_report_search" model="ir.ui.view">
        <field name="name">employee.salary.report.search</field>
        <field name="model">employee.salary.report</field>
        <field name="arch" type="xml">
            <search string="Salary Reports">
                <field name="employee_id"/>
                <field name="month_name"/>
                <field name="contract_id"/>
                <field name="payslip_id"/>

                <group expand="0" string="Group By">
                    <filter string="Month" name="group_by_month" context="{'group_by':'month_name'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Contract" name="group_by_contract" context="{'group_by':'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_salary_report" model="ir.actions.act_window">
        <field name="name">Salary Reports</field>
        <field name="res_model">employee.salary.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_salary_report_search"/>
        <field name="context">{'search_default_group_by_month': 1}</field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_employee_salary_report_root"
              name="Salary Reports"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_employee_salary_report"/>

</odoo>
