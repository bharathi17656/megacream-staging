<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         PARTY REPORT — List View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_party_report_list" model="ir.ui.view">
        <field name="name">l4e.party.report.list</field>
        <field name="model">l4e.party.report</field>
        <field name="arch" type="xml">
            <list string="Party Inactivity Report"
                  decoration-danger="inactivity_status == 'dormant_90'"
                  decoration-warning="inactivity_status == 'inactive_60'"
                  decoration-info="inactivity_status == 'inactive_30'"
                  decoration-success="inactivity_status == 'active'"
                  decoration-muted="inactivity_status == 'never_ordered'"
                  create="false" edit="false" delete="false">
                <field name="partner_id" string="Customer / Party"/>
                <field name="phone" widget="phone" optional="show"/>
                <field name="email" widget="email" optional="show"/>
                <field name="city" optional="show"/>
                <field name="state_id" optional="hide"/>
                <field name="last_order_id" string="Last Order Ref" optional="show"/>
                <field name="last_order_date" string="Last Order Date" widget="date"/>
                <field name="inactivity_duration" string="Last Purchased" optional="show"/>
                <field name="days_since_last_order" string="Days Inactive" optional="show"
                       decoration-danger="days_since_last_order &gt; 90"
                       decoration-warning="days_since_last_order &gt; 60 and days_since_last_order &lt;= 90"
                       decoration-info="days_since_last_order &gt; 30 and days_since_last_order &lt;= 60"
                       decoration-success="days_since_last_order &lt;= 30"/>
                <field name="inactivity_status" widget="badge" string="Inactivity Tier"
                       decoration-danger="inactivity_status == 'dormant_90'"
                       decoration-warning="inactivity_status == 'inactive_60'"
                       decoration-info="inactivity_status == 'inactive_30'"
                       decoration-success="inactivity_status == 'active'"
                       decoration-muted="inactivity_status == 'never_ordered'"/>
                <field name="order_count" string="Total Orders" sum="Total Orders" optional="show"/>
                <field name="total_spent" string="Total Spent" widget="monetary" sum="Total Revenue" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" string="Salesperson" optional="show"/>
                <button name="action_view_partner" string="View Customer" type="object" icon="fa-user"/>
                <button name="action_create_quotation" string="New Quote" type="object" icon="fa-shopping-cart"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PARTY REPORT — Search View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_party_report_search" model="ir.ui.view">
        <field name="name">l4e.party.report.search</field>
        <field name="model">l4e.party.report</field>
        <field name="arch" type="xml">
            <search string="Search Party Report">
                <field name="partner_id" string="Customer / Party"/>
                <field name="phone" string="Phone"/>
                <field name="email" string="Email"/>
                <field name="city" string="City"/>
                <field name="user_id" string="Salesperson"/>
                <field name="last_order_id" string="Last Order"/>

                <!-- Inactivity Time Filters -->
                <filter string="🚨 Inactive > 1 Month (30+ Days)" name="filter_inactive_30"
                        domain="[('days_since_last_order', '&gt;=', 30)]"/>
                <filter string="⚠️ Inactive > 2 Months (60+ Days)" name="filter_inactive_60"
                        domain="[('days_since_last_order', '&gt;=', 60)]"/>
                <filter string="🛑 Dormant > 3 Months (90+ Days)" name="filter_dormant_90"
                        domain="[('days_since_last_order', '&gt;=', 90)]"/>
                <separator/>
                <filter string="🟢 Active (≤ 30 Days)" name="filter_active"
                        domain="[('inactivity_status', '=', 'active')]"/>
                <filter string="⚪ Never Ordered" name="filter_never_ordered"
                        domain="[('inactivity_status', '=', 'never_ordered')]"/>
                <separator/>
                <filter string="📞 Has Phone Number" name="filter_has_phone"
                        domain="[('phone', '!=', False)]"/>

                <!-- Group By -->
                <group>
                    <filter string="Inactivity Tier" name="groupby_status" context="{'group_by': 'inactivity_status'}"/>
                    <filter string="Salesperson" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="City" name="groupby_city" context="{'group_by': 'city'}"/>
                    <filter string="State" name="groupby_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Last Order Month" name="groupby_last_order_month" context="{'group_by': 'last_order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PARTY REPORT — Pivot View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_party_report_pivot" model="ir.ui.view">
        <field name="name">l4e.party.report.pivot</field>
        <field name="model">l4e.party.report</field>
        <field name="arch" type="xml">
            <pivot string="Party Inactivity Pivot Analysis">
                <field name="inactivity_status" type="row"/>
                <field name="last_order_date" type="col" interval="month"/>
                <field name="partner_id" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="total_spent" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PARTY REPORT — Graph View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_party_report_graph" model="ir.ui.view">
        <field name="name">l4e.party.report.graph</field>
        <field name="model">l4e.party.report</field>
        <field name="arch" type="xml">
            <graph string="Customers by Inactivity Status" type="bar">
                <field name="inactivity_status"/>
                <field name="partner_id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         PARTY REPORT — Window Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_party_report" model="ir.actions.act_window">
        <field name="name">Party Report</field>
        <field name="res_model">l4e.party.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="view_party_report_search"/>
        <field name="context">{'search_default_filter_inactive_30': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All customers are currently active!
            </p>
            <p>
                This report monitors customer ordering frequency and highlights parties who haven't ordered recently so your sales team can contact them.
            </p>
        </field>
    </record>

    <!-- Action View Bindings -->
    <record id="action_party_report_list_binding" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_party_report_list"/>
        <field name="act_window_id" ref="action_party_report"/>
    </record>

    <record id="action_party_report_pivot_binding" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_party_report_pivot"/>
        <field name="act_window_id" ref="action_party_report"/>
    </record>

    <record id="action_party_report_graph_binding" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_party_report_graph"/>
        <field name="act_window_id" ref="action_party_report"/>
    </record>

</odoo>
