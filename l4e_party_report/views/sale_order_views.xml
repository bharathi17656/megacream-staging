<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View Customization -->
    <record id="view_order_form_inherit_party_fridge" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.party.fridge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Header button for logging return -->
            <xpath expr="//header" position="inside">
                <button name="action_open_fridge_return_wizard"
                        string="Log Fridge Return"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_party_order or fridge_qty_missing == 0"/>
            </xpath>

            <!-- Dedicated Notebook Page for Party & Refrigerator Tracking -->
            <xpath expr="//notebook" position="inside">
                <page string="Party &amp; Refrigerator" name="party_refrigerator">
                    <group>
                        <group string="Party Order Configuration">
                            <field name="is_party_order"/>
                            <field name="fridge_serial_no" invisible="not is_party_order" placeholder="e.g. FRIDGE-01, FRIDGE-02"/>
                            <field name="fridge_expected_return_date" invisible="not is_party_order"/>
                            <field name="fridge_actual_return_date" invisible="not is_party_order or fridge_qty_returned == 0" readonly="1"/>
                        </group>
                        <group string="Refrigerator Tracking &amp; Status" invisible="not is_party_order">
                            <field name="fridge_qty_dispatched"/>
                            <field name="fridge_qty_returned"/>
                            <field name="fridge_qty_missing" class="oe_bold" decoration-danger="fridge_qty_missing &gt; 0" decoration-success="fridge_qty_missing == 0"/>
                            <field name="fridge_return_status" widget="badge"
                                   decoration-danger="fridge_return_status == 'pending'"
                                   decoration-warning="fridge_return_status == 'partial'"
                                   decoration-success="fridge_return_status == 'returned'"/>
                        </group>
                    </group>
                    <group string="Party Notes &amp; Follow-Up Remarks" invisible="not is_party_order">
                        <field name="fridge_notes" nolabel="1" placeholder="Enter party event location, contact details at venue, or return follow-up notes..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Partner Form View: Smart Button for Party Orders -->
    <record id="view_partner_form_inherit_party_fridge" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.party.fridge</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_party_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-snowflake-o"
                        invisible="party_order_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="missing_fridge_count"/> Missing
                        </span>
                        <span class="o_stat_text">Party Orders (<field name="party_order_count"/>)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
